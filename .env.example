# Bybit API Configuration
BYBIT_API_KEY=your_bybit_api_key_here
BYBIT_API_SECRET=your_bybit_api_secret_here
BYBIT_TESTNET=true

# Grok AI Configuration
GROK_API_KEY=your_grok_api_key_here
GROK_MODEL=grok-beta

# Trading Configuration
TRADING_SYMBOL=BTC/USDT  # Fallback symbol (используется только если screening не сработал)
TRADING_TIMEFRAME=30m
TRADING_BALANCE=10.0

# Daily Screener Configuration
SCREENER_ENABLED=true
SCREENER_INTERVAL_HOURS=24
SCREENER_TOP_N=20
SCREENER_MAX_SYMBOLS=2

# Risk Management
STOP_LOSS_PCT=2.0
MIN_RISK_REWARD=1.5
MIN_AI_CONFIDENCE=80.0

# Scheduling
CYCLE_INTERVAL_MINUTES=30

# System Configuration
DRY_RUN=true
LOG_LEVEL=INFO
LOG_ROTATION=100 MB
LOG_RETENTION=30 days

# Storage
STORAGE_PATH=storage/history.json
