# Sentinel AI Trading Bot Configuration
# Copy this file to .env and fill in your actual values

# ============================================
# Exchange Configuration (Bybit)
# ============================================
BYBIT_API_KEY=your_bybit_api_key_here
BYBIT_API_SECRET=your_bybit_api_secret_here
BYBIT_TESTNET=true  # Set to false for production

# ============================================
# AI Configuration (Grok / x.ai)
# ============================================
GROK_API_KEY=your_grok_api_key_here
GROK_MODEL=grok-beta  # Model name (usually grok-beta)

# ============================================
# Trading Configuration
# ============================================
# Fallback symbol if screening doesn't work
TRADING_SYMBOL=BTC/USDT

# Candle timeframe for analysis
TRADING_TIMEFRAME=30m

# Starting balance in USDT
TRADING_BALANCE=10.0

# ============================================
# Daily Screener Configuration
# ============================================
# Enable daily screening of top coins
SCREENER_ENABLED=true

# How often to run screening (in hours)
SCREENER_INTERVAL_HOURS=24

# Number of top volume coins to scan
SCREENER_TOP_N=20

# Maximum number of symbols to trade simultaneously
SCREENER_MAX_SYMBOLS=2

# ============================================
# Risk Management
# ============================================
# Stop-loss percentage (2% = stop at 2% below entry)
STOP_LOSS_PCT=2.0

# Minimum risk/reward ratio (1.5 = take-profit must be at least 1.5x the risk)
MIN_RISK_REWARD=1.5

# Minimum AI confidence required to execute trade (0-100)
MIN_AI_CONFIDENCE=80.0

# ============================================
# Scheduling
# ============================================
# Trading cycle interval in minutes
CYCLE_INTERVAL_MINUTES=30

# ============================================
# System Configuration
# ============================================
# Dry run mode (true = no real trades, false = real trading)
DRY_RUN=true

# Logging level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Log rotation size
LOG_ROTATION=100 MB

# Log retention period
LOG_RETENTION=30 days

# ============================================
# Storage
# ============================================
# Path to history JSON file
STORAGE_PATH=storage/history.json
